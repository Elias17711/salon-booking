# Copy this file to .env and fill in the values.

# Token from @BotFather on Telegram
BOT_TOKEN=123456:replace-me

# Your own Telegram chat ID, so the bot can message you about new bookings.
# Send /myid to your bot to find it, then paste the number here.
OWNER_CHAT_ID=

# Password for the web dashboard (choose something long)
DASHBOARD_PASSWORD=change-this-password

# Any long random text. Keeps dashboard logins valid after a restart.
SECRET_KEY=change-this-too

# Optional: a hosted PostgreSQL address (for example from Neon). When set, the app
# stores everything there instead of in salon.db, so data survives restarts on
# hosts like Render. Leave empty to use the local salon.db file.
DATABASE_URL=

# Optional
DB_PATH=salon.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
